{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/terrariums",
      "destination": "/api/shelf?route=terrariums"
    },
    {
      "source": "/api/keepers",
      "destination": "/api/shelf?route=keepers"
    },
    {
      "source": "/s/:id",
      "destination": "/api/shelf?route=share&id=:id"
    }
  ]
}
